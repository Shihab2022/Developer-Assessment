
# Backend REST API base, including the `/api/v1` prefix (no trailing slash).
NEXT_PUBLIC_API_URL=""

# Canonical origin of this frontend. Used for Open Graph / Twitter metadata and
# absolute share links.
NEXT_PUBLIC_SITE_URL=""

# Public source repository — linked from the footer and quoted in the
# playground's outbound User-Agent.
NEXT_PUBLIC_REPO_URL=""

# ---------- Code runner (optional) ----------
# Optional Piston-compatible runner for the playground's Go and Java tabs.
# Leave unset to use the built-in `/api/playground/execute` proxy, which talks
# to the official Go playground and the public Judge0 instance (see below).
# NEXT_PUBLIC_CODE_RUNNER_URL=""

# ---------- Playground preview assets ----------
# Loaded inside the sandboxed preview iframe. Each is pinned to the version the
# app compiles with; override only to self-host the assets.
NEXT_PUBLIC_PLAYGROUND_TAILWIND_CDN_URL=""
NEXT_PUBLIC_PLAYGROUND_REACT_CDN_URL=""
NEXT_PUBLIC_PLAYGROUND_REACT_DOM_CDN_URL=""
NEXT_PUBLIC_PLAYGROUND_MUI_CDN_URL=""
NEXT_PUBLIC_PLAYGROUND_BABEL_CDN_URL=""
NEXT_PUBLIC_PLAYGROUND_FONT_URL=""

# ---------- Playground runtimes (browser WebAssembly workers) ----------
# Runtime directories must keep their trailing slash.
NEXT_PUBLIC_PYODIDE_CDN_BASE=""
NEXT_PUBLIC_SQLJS_CDN_BASE="/"

GO_PLAYGROUND_URL=""
JUDGE0_URL=""
JUDGE0_JAVA_LANGUAGE_ID=""
