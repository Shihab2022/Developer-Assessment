
# Backend REST API base, including the `/api/v1` prefix (no trailing slash).
NEXT_PUBLIC_API_URL="http://localhost:5000/api/v1"

# Canonical origin of this frontend. Used for Open Graph / Twitter metadata and
# ALL absolute share links (candidate exam/interview URLs, competition links).
# On deployment set this to the real public origin - otherwise shared links
# resolve to localhost.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Public source repository — linked from the footer and quoted in the
# playground's outbound User-Agent.
NEXT_PUBLIC_REPO_URL="https://github.com/Shihab2022/Developer-Assessment"

# ---------- Code runner (optional) ----------
# Optional Piston-compatible runner for the playground's Go and Java tabs.
# Leave unset to use the built-in `/api/playground/execute` proxy, which talks
# to the official Go playground and the public Judge0 instance (see below).
# NEXT_PUBLIC_CODE_RUNNER_URL=""

# ---------- Playground preview assets ----------
# Loaded inside the sandboxed preview iframe. Each is pinned to the version the
# app compiles with; override only to self-host the assets.
NEXT_PUBLIC_PLAYGROUND_TAILWIND_CDN_URL="https://cdn.tailwindcss.com/3.4.19"
NEXT_PUBLIC_PLAYGROUND_REACT_CDN_URL="https://unpkg.com/react@18.3.1/umd/react.production.min.js"
NEXT_PUBLIC_PLAYGROUND_REACT_DOM_CDN_URL="https://unpkg.com/react-dom@18.3.1/umd/react-dom.production.min.js"
NEXT_PUBLIC_PLAYGROUND_MUI_CDN_URL="https://unpkg.com/@mui/material@5.15.20/umd/material-ui.production.min.js"
NEXT_PUBLIC_PLAYGROUND_BABEL_CDN_URL="https://unpkg.com/@babel/standalone@7.24.7/babel.min.js"
NEXT_PUBLIC_PLAYGROUND_FONT_URL="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap"

# ---------- Playground runtimes (browser WebAssembly workers) ----------
# Runtime directories must keep their trailing slash.
NEXT_PUBLIC_PYODIDE_CDN_BASE="https://cdn.jsdelivr.net/pyodide/v0.26.4/full/"
NEXT_PUBLIC_SQLJS_CDN_BASE="https://cdn.jsdelivr.net/npm/sql.js@1.11.0/dist/"

# =============================================================================
# Server-only (read by the `/api/playground/execute` route handler at request
# time). Do NOT prefix these with NEXT_PUBLIC_ — they must stay out of the
# browser bundle.
# =============================================================================
# Official Go playground compile endpoint, used by the Go tab.
GO_PLAYGROUND_URL="https://go.dev/_/compile?backend="
# Judge0 CE submissions endpoint, used by the Java tab.
JUDGE0_URL="https://ce.judge0.com/submissions?base64_encoded=false&wait=true"
# Judge0 language id for Java (62 = "Java (OpenJDK 13.0.1)" on the public instance).
JUDGE0_JAVA_LANGUAGE_ID="62"
