# Backend API base URL (without trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Optional: Piston-compatible code runner for the playground's Go and Java tabs
# (e.g. a self-hosted engine.getpiston.dev instance or a whitelisted account).
# Leave unset to use the built-in /api/playground/execute proxy, which relays to
# the official Go playground and the public Judge0 instance from the server.
# NEXT_PUBLIC_CODE_RUNNER_URL=
