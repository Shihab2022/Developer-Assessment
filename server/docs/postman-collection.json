        { "name": "Start Attempt", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/assessments/{{assessmentId}}/attempts/start" } },
        { "name": "Get Attempt", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/attempts/{{attemptId}}" } },
