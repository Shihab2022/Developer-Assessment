{
  "info": {
    "name": "Developer Assessment & Coding Platform API",
    "description": "Postman collection for the Developer Assessment & Coding Platform backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "assessmentId", "value": "" },
    { "key": "problemId", "value": "" },
    { "key": "attemptId", "value": "" },
    { "key": "submissionId", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "companyId", "value": "" },
    { "key": "invitationId", "value": "" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        { "name": "Register (Candidate)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/auth/register", "body": { "mode": "raw", "raw": "{\n  \"name\": \"Cody Candidate\",\n  \"email\": \"candidate@example.com\",\n  \"password\": \"Passw0rd123\",\n  \"role\": \"CANDIDATE\"\n}" } } },
        { "name": "Register (Recruiter)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/auth/register", "body": { "mode": "raw", "raw": "{\n  \"name\": \"Rina Recruiter\",\n  \"email\": \"recruiter@example.com\",\n  \"password\": \"Passw0rd123\",\n  \"role\": \"RECRUITER\"\n}" } } },
        { "name": "Login", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/auth/login", "body": { "mode": "raw", "raw": "{\n  \"email\": \"recruiter@example.com\",\n  \"password\": \"Passw0rd123\"\n}" } } },
        { "name": "Refresh Token", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/auth/refresh-token", "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" } } },
        { "name": "Logout", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/auth/logout", "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" } } },
        { "name": "Me", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/auth/me" } }
      ]
    },
    {
      "name": "Users",
      "item": [
        { "name": "Get Me", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/users/me" } },
        { "name": "Update Me", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/users/me", "body": { "mode": "raw", "raw": "{\n  \"bio\": \"Updated bio\",\n  \"skills\": [\"typescript\", \"nodejs\"],\n  \"jobTitle\": \"Senior Engineer\"\n}" } } },
        { "name": "Change Password", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/users/me/password", "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"Passw0rd123\",\n  \"newPassword\": \"NewPassw0rd123\"\n}" } } },
        { "name": "My Activity", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/users/me/activity" } }
      ]
    },
    {
      "name": "Companies",
      "item": [
        { "name": "Create Company", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/companies", "body": { "mode": "raw", "raw": "{\n  \"name\": \"TechCorp Solutions\",\n  \"description\": \"A software company\",\n  \"website\": \"https://techcorp.example.com\",\n  \"industry\": \"Software\",\n  \"location\": \"Dhaka\"\n}" } } },
        { "name": "Get Company", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/companies/{{companyId}}" } },
        { "name": "Update Company", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/companies/{{companyId}}", "body": { "mode": "raw", "raw": "{\n  \"description\": \"Updated description\"\n}" } } },
        { "name": "List Members", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/companies/{{companyId}}/members" } }
      ]
    },    {
      "name": "Problems",
      "item": [
        { "name": "Create MCQ Problem", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/problems", "body": { "mode": "raw", "raw": "{\n  \"title\": \"JS Event Loop\",\n  \"description\": \"Which statement is true about the event loop?\",\n  \"type\": \"MCQ\",\n  \"difficulty\": \"EASY\",\n  \"points\": 5,\n  \"category\": \"javascript\",\n  \"options\": [\n    { \"text\": \"It runs immediately\", \"isCorrect\": false, \"order\": 0 },\n    { \"text\": \"Microtask queue\", \"isCorrect\": true, \"order\": 1 },\n    { \"text\": \"Macrotask queue\", \"isCorrect\": false, \"order\": 2 }\n  ]\n}" } } },
        { "name": "Create Coding Problem", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/problems", "body": { "mode": "raw", "raw": "{\n  \"title\": \"Two Sum\",\n  \"description\": \"Return indices of two numbers that add up to target.\",\n  \"type\": \"CODING\",\n  \"difficulty\": \"EASY\",\n  \"points\": 15,\n  \"timeLimit\": 15,\n  \"memoryLimit\": 256,\n  \"testCases\": [\n    { \"input\": \"[2,7,11,15]\\n9\", \"expectedOutput\": \"[0,1]\", \"isHidden\": false, \"order\": 0 },\n    { \"input\": \"[3,2,4]\\n6\", \"expectedOutput\": \"[1,2]\", \"isHidden\": true, \"order\": 1 }\n  ]\n}" } } },
        { "name": "List Problems", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/problems?page=1&limit=10&sortBy=createdAt&sortOrder=desc" } },
        { "name": "Search Problems", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/problems/search?q=javascript" } },
        { "name": "Get Problem", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/problems/{{problemId}}" } },
        { "name": "Update Problem", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/problems/{{problemId}}", "body": { "mode": "raw", "raw": "{\n  \"points\": 10\n}" } } },
        { "name": "Delete Problem", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/problems/{{problemId}}" } }
      ]
    },
    {
      "name": "Assessments",
      "item": [
        { "name": "Create Assessment", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/assessments", "body": { "mode": "raw", "raw": "{\n  \"title\": \"Backend Developer Assessment\",\n  \"description\": \"Screening assessment\",\n  \"instructions\": \"Answer all questions. Timer is server-side.\",\n  \"durationMinutes\": 45,\n  \"passingScore\": 15,\n  \"maxAttempts\": 1,\n  \"showResults\": true\n}" } } },
        { "name": "List Assessments", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/assessments?page=1&limit=10&status=PUBLISHED" } },
        { "name": "Get Assessment", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/assessments/{{assessmentId}}" } },
        { "name": "Update Assessment", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/assessments/{{assessmentId}}", "body": { "mode": "raw", "raw": "{\n  \"description\": \"Updated instructions\"\n}" } } },
        { "name": "Publish Assessment", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/assessments/{{assessmentId}}/publish" } },
