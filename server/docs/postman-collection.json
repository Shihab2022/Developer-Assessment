                "exec": [
                  "pm.test(\"Questions retrieved\", () => pm.expect(pm.response.code).to.equal(200));",
                  "const data = pm.response.json().data;",
                  "if (!Array.isArray(data) || data.length === 0) return;",
                  "const mcq = data.find((q) => q.problem && Array.isArray(q.problem.options) && q.problem.options.length > 0);",
                  "if (!mcq) return;",
                  "pm.collectionVariables.set(\"problemId\", mcq.problem.id);",
                  "pm.collectionVariables.set(\"mcqOptionId\", mcq.problem.options[0].id);"
                ]
