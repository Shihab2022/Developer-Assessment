      "name": "Anti-Cheating",
      "item": [
        { "name": "Record Event", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/attempts/{{attemptId}}/anti-cheating-events", "body": { "mode": "raw", "raw": "{\n  \"eventType\": \"TAB_SWITCH\",\n  \"metadata\": { \"detail\": \"user switched tab\" }\n}" } } },
        { "name": "List Events", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/attempts/{{attemptId}}/anti-cheating-events" } }
