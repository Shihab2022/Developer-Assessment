        { "name": "Add Problem", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/assessments/{{assessmentId}}/problems", "body": { "mode": "raw", "raw": "{\n  \"problemId\": \"{{problemId}}\",\n  \"points\": 10,\n  \"order\": 1\n}" } } },
        { "name": "List Problems", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/assessments/{{assessmentId}}/problems" } },
        { "name": "Update Problem", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/assessments/{{assessmentId}}/problems/{{problemId}}", "body": { "mode": "raw", "raw": "{\n  \"points\": 12,\n  \"section\": \"Core\"\n}" } } },
        { "name": "Remove Problem", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/assessments/{{assessmentId}}/problems/{{problemId}}" } }
      ]
    },    {
      "name": "Invitations",
      "item": [
        { "name": "Invite Candidates", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/assessments/{{assessmentId}}/invitations", "body": { "mode": "raw", "raw": "{\n  \"candidates\": [\n    { \"email\": \"candidate@example.com\" }\n  ]\n}" } } },
        { "name": "List Invitations", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/assessments/{{assessmentId}}/invitations" } },
        { "name": "Resend Invitation", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/invitations/{{invitationId}}/resend" } },
        { "name": "Accept Invitation", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/invitations/{{invitationId}}/accept" } },
        { "name": "Reject Invitation", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/invitations/{{invitationId}}/reject" } },
        { "name": "My Invitations", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/candidates/invitations" } }
      ]
