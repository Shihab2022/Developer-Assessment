              "raw": "{\n  \"name\": \"Cody Candidate\",\n  \"email\": \"candidate@devassess.local\",\n  \"password\": \"Candid8te!\",\n  \"role\": \"CANDIDATE\",\n  \"phone\": \"+8801700000000\"\n}"
