            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/payments/cancel",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tran_id\": \"TX-...\"\n}"
            }
          },
          "auth": {
            "type": "noauth"
          }
        },
        {
          "name": "IPN Callback",
