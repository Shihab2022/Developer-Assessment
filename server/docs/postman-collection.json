        { "name": "Cancel Callback", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/payments/cancel", "body": { "mode": "raw", "raw": "{\n  \"tran_id\": \"TX-...\"\n}" } } },
        { "name": "IPN Callback", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/payments/ipn", "body": { "mode": "raw", "raw": "{\n  \"tran_id\": \"TX-...\",\n  \"status\": \"VALID\"\n}" } } },
        { "name": "Get Payment", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/payments/{{paymentId}}" } },
        { "name": "List Payments", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/payments" } }
