        { "name": "Success Callback", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/payments/success", "body": { "mode": "raw", "raw": "{\n  \"tran_id\": \"TX-...\"\n}" } } },
