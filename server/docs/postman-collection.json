            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/payments/fail",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tran_id\": \"TX-...\"\n}"
            }
          },
          "auth": {
            "type": "noauth"
          }
        },
        {
          "name": "Cancel Callback",
