        { "name": "Update Answer", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/attempts/{{attemptId}}/answers/ANSWER_UUID", "body": { "mode": "raw", "raw": "{\n  \"answer\": { \"selectedOptionId\": \"OPTION_UUID\" }\n}" } } },
        { "name": "Submit Attempt", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/attempts/{{attemptId}}/submit" } },
