# ---------- Core ----------
NODE_ENV="development"
PORT=5000
APP_URL="http://localhost:5000"
API_URL="http://localhost:5000"
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# ---------- Database (PostgreSQL) ----------
DATABASE_URL=

# ---------- Security ----------
BCRYPT_SALT_ROUNDS=10
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ---------- Redis (optional; set REDIS_ENABLED=true to activate caching) ----------
REDIS_URL="redis://localhost:6379"
REDIS_ENABLED="false"

# ---------- SSLCommerz ----------
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE="false"
SSLCOMMERZ_PAYMENT_API="https://sandbox.sslcommerz.com/gwprocess/v4/api.php"
SSLCOMMERZ_VALIDATION_API="https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php?wsdl"
SSLCOMMERZ_SUCCESS_URL=
SSLCOMMERZ_FAIL_URL=
SSLCOMMERZ_CANCEL_URL=

# ---------- Code execution sandbox (optional) ----------

CODE_RUNNER_URL=
ALLOW_LOCAL_SANDBOX="false"

# ---------- AI video interview review (optional) ----------
# Without an API key the built-in deterministic rubric engine grades the
# answers, so the feature works offline. Set AI_API_KEY to use any
# OpenAI-compatible provider for the marks and written feedback.
AI_API_KEY=
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_TIMEOUT_MS=45000
AI_ENABLED="true"

# ---------- Video interview defaults ----------

# Seconds allowed per question (5 minutes) unless an interview overrides it.
INTERVIEW_QUESTION_TIME_SECONDS=300
# Body limit for interview answer uploads (transcript + evidence frames + clip).
INTERVIEW_MAX_UPLOAD_MB=12
# Hours a candidate link stays valid after it is opened.
INTERVIEW_SESSION_TTL_HOURS=72
# Public base URL used to build candidate interview links.
FRONTEND_URL="http://localhost:3000"

# ---------- Email delivery (Google / Gmail SMTP) ----------
# Use a Gmail App Password (Google Account → Security → 2-Step Verification →
# App passwords) — NOT your account password. When SMTP_USERNAME / SMTP_PASSWORD
# are empty, or MAIL_ENABLED="false", outbound email is disabled and new
# registrations are auto-verified so local development still works.
SMTP_HOST="smtp.gmail.com"
# 465 = implicit TLS (SMTP_SECURE=true). Use 587 with SMTP_SECURE=false for STARTTLS.
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USERNAME=""
SMTP_PASSWORD=""
# Optional display name / address. Defaults to "DevAssess <SMTP_USERNAME>".
MAIL_FROM=""
MAIL_ENABLED="true"
# How long an email-confirmation link stays valid.
EMAIL_VERIFICATION_EXPIRES_IN_HOURS=24

# ---------- Seed credentials (local/dev only; never reuse in production) ----------
SEED_ADMIN_EMAIL="admin@devassess.local"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_RECRUITER_EMAIL="recruiter@techcorp.dev"
SEED_RECRUITER_PASSWORD="Recruit123!"
SEED_CANDIDATE_EMAIL="candidate@devassess.local"
SEED_CANDIDATE_PASSWORD="Candid8te!"